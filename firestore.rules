rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Fields:
    //   - title: string (required)
    //   - description: string (optional)
    //   - category: string (required, enum)
    //   - thumbnailUrl: string (required, uri)
    //   - videoUrl: string (optional, uri)
    //   - createdAt: number (required)
    //
    // Collection: settings
    // Document: global
    // Fields:
    //   - companyName: string
    //   - primaryColor: string
    //   - secondaryColor: string
    //   - contactEmail: string
    //   - youtubeUrl: string
    //   - instagramUrl: string
    //   - linkedinUrl: string
    //
    // Collection: users
    // Fields:
    //   - email: string (required)
    //   - role: string (required, enum)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "mediaplatee@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'category', 'thumbnailUrl', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.category in ['Educational', 'YouTube', 'Corporate', 'Other'] &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() < 1000 &&
             data.createdAt is number;
    }

    function isValidSettings(data) {
      return data.keys().hasAny(['companyName', 'primaryColor']) &&
             (!('companyName' in data) || (data.companyName is string && data.companyName.size() < 100)) &&
             (!('primaryColor' in data) || (data.primaryColor is string && data.primaryColor.size() < 20));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.role in ['admin', 'editor'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /projects/{projectId} {
      allow read: if true; // Public portfolio
      allow create, update, delete: if isAdmin() && isValidProject(request.resource.data);
    }

    match /settings/global {
      allow read: if true; // Public settings
      allow write: if isAdmin() && isValidSettings(request.resource.data);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() && isValidUser(request.resource.data);
      allow update: if isAdmin() && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
